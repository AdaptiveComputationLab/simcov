; Dimensions: x y z
  dim =                         1100 1100 1100

; Whole lung dimensions: x y z
  whole-lung-dim =              16000 13333 6667

; Number of timesteps
  timesteps =                   6720

; Location of multiple initial infections, of form "x1,y1,z1,t1 x2,y2,z2,t2..."
; where x,y,z are grid coords and t is a timestep, or
; "uniform:N" for N uniformly distributed points or
; "random:N" for N randomly distributed points
  infection-coords =            250,250,250,0 250,250,350,0 250,250,450,0 250,250,550,0 250,250,650,0 250,250,750,0 250,250,850,0 250,350,250,0 250,350,350,0 250,350,450,0 250,350,550,0 250,350,650,0 250,350,750,0 250,350,850,0 250,450,250,0 250,450,350,0 250,450,450,0 250,450,550,0 250,450,650,0 250,450,750,0 250,450,850,0 250,550,250,0 250,550,350,0 250,550,450,0 250,550,550,0 250,550,650,0 250,550,750,0 250,550,850,0 250,650,250,0 250,650,350,0 250,650,450,0 250,650,550,0 250,650,650,0 250,650,750,0 250,650,850,0 250,750,250,0 250,750,350,0 250,750,450,0 250,750,550,0 250,750,650,0 250,750,750,0 250,750,850,0 250,850,250,0 250,850,350,0 250,850,450,0 250,850,550,0 250,850,650,0 250,850,750,0 250,850,850,0 350,250,250,0 350,250,350,0 350,250,450,0 350,250,550,0 350,250,650,0 350,250,750,0 350,250,850,0 350,350,250,0 350,350,350,0 350,350,450,0 350,350,550,0 350,350,650,0 350,350,750,0 350,350,850,0 350,450,250,0 350,450,350,0 350,450,450,0 350,450,550,0 350,450,650,0 350,450,750,0 350,450,850,0 350,550,250,0 350,550,350,0 350,550,450,0 350,550,550,0 350,550,650,0 350,550,750,0 350,550,850,0 350,650,250,0 350,650,350,0 350,650,450,0 350,650,550,0 350,650,650,0 350,650,750,0 350,650,850,0 350,750,250,0 350,750,350,0 350,750,450,0 350,750,550,0 350,750,650,0 350,750,750,0 350,750,850,0 350,850,250,0 350,850,350,0 350,850,450,0 350,850,550,0 350,850,650,0 350,850,750,0 350,850,850,0 450,250,250,0 450,250,350,0 450,250,450,0 450,250,550,0 450,250,650,0 450,250,750,0 450,250,850,0 450,350,250,0 450,350,350,0 450,350,450,0 450,350,550,0 450,350,650,0 450,350,750,0 450,350,850,0 450,450,250,0 450,450,350,0 450,450,450,0 450,450,550,0 450,450,650,0 450,450,750,0 450,450,850,0 450,550,250,0 450,550,350,0 450,550,450,0 450,550,550,0 450,550,650,0 450,550,750,0 450,550,850,0 450,650,250,0 450,650,350,0 450,650,450,0 450,650,550,0 450,650,650,0 450,650,750,0 450,650,850,0 450,750,250,0 450,750,350,0 450,750,450,0 450,750,550,0 450,750,650,0 450,750,750,0 450,750,850,0 450,850,